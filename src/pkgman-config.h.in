//! \file pkgman-config.h.in
//! \brief Build-time configuration header for pkgman.
//!
//! This header is generated by Meson from `pkgman-config.h.in`
//! and provides package metadata and default filesystem paths.
//! All macros are substituted at configure time.
//!
//! \copyright See COPYING for license terms and COPYRIGHT for notices.

#pragma once

//! \name Package metadata
//!@{
#define PACKAGE_NAME      "@PACKAGE_NAME@"      //!< Project name
#define PACKAGE_VERSION   "@PACKAGE_VERSION@"   //!< Project version string
#define PACKAGE_STRING    "@PACKAGE_STRING@"    //!< Combined name + version
#define PACKAGE_BUGREPORT "@PACKAGE_BUGREPORT@" //!< Issue tracker URL
#define PACKAGE_URL       "@PACKAGE_URL@"       //!< Project homepage URL
//!@}

//! \name Installation directories
//!@{
#define SYSCONFDIR        "@SYSCONFDIR@"        //!< System configuration directory
#define SHAREDSTATEDIR    "@SHAREDSTATEDIR@"    //!< Shared state directory
#define BINDIR            "@BINDIR@"            //!< User executables directory
#define SBINDIR           "@SBINDIR@"           //!< System executables directory
//!@}

//! \name Dependency metadata
//!@{
#define LIBPKGCORE_VERSION "@LIBPKGCORE_VERSION@" //!< Linked libpkgcore version string
//!@}
